import { UiI18n } from "i18n_types.slint";

export component MasterView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0c0b0f;

    in-out property <string> current_root: "C";
    in-out property <string> current_scale: "Chromatic";
    in-out property <int> current_octave: 4;
    in-out property <int> octave_range: 2;
    in-out property <int> pitch_quantization: 50; // 0, 25, 50, 75, 100
    in-out property <string> filter_speed: "Fast";
    in-out property <string> midi_mode: "Standard";
    in-out property <int> pb_range: 2; // 2, 12, 24, 48
    in-out property <string> app_version: "v0.1.0";
    in property <UiI18n> i18n;
    callback language_toggled();

    // Callbacks to simulate touching the UI
    callback root_changed(string);
    callback scale_changed(string);
    callback octave_changed(int);
    callback range_changed(int);
    callback quantization_changed(int);
    callback filter_changed(string);
    callback midi_mode_changed(string);
    callback pb_range_changed(int);
    callback switch_to_slave();

    // Theme
    property <color> accent: #00f0ff;
    property <color> text_color: #ffffff;
    property <color> dim_text: #666670;
    property <color> panel_bg: #1a1a24;
    
    // Helper function for roots
    property <[string]> roots: ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    property <int> root_idx: 0;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;

        // ROW 1: Tonal Settings (Root, Scale, & Back to Tuner Button)
        HorizontalLayout {
            spacing: 12px;
            height: 136px;
            
            // Root Note
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 240px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.root_note; color: dim_text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 10px;
                        TouchArea {
                            width: 58px; height: 58px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 29px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "<"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.root_idx = root.root_idx > 0 ? root.root_idx - 1 : 11;
                                root.current_root = root.roots[root.root_idx];
                                root.root_changed(root.roots[root.root_idx]); 
                            }
                        }
                        Text { text: root.roots[root.root_idx]; font-size: 40px; font-weight: 900; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 65px; }
                        TouchArea {
                            width: 58px; height: 58px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 29px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: ">"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.root_idx = root.root_idx < 11 ? root.root_idx + 1 : 0;
                                root.current_root = root.roots[root.root_idx];
                                root.root_changed(root.roots[root.root_idx]); 
                            }
                        }
                    }
                }
            }

            // Scale
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 321px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.scale; color: dim_text; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px; alignment: center;
                        for item in [
                            { id: "Chromatic", label: root.i18n.scale_chrom },
                            { id: "Major", label: root.i18n.scale_major },
                            { id: "Minor", label: root.i18n.scale_minor },
                            { id: "Penta", label: root.i18n.scale_penta }
                        ]: TouchArea {
                            height: 48px;
                            Rectangle {
                                border-radius: 10px;
                                background: root.current_scale == item.id ? accent : (parent.pressed ? #444458 : #333340);
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; alignment: center;
                                    Text {
                                        text: item.label;
                                        color: root.current_scale == item.id ? #000000 : text_color;
                                        font-size: 16px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            clicked => { 
                                root.current_scale = item.id;
                                root.scale_changed(item.id); 
                            }
                        }
                    }
                }
            }

            // Back to Tuner (Slave View) Button (Full 183px restored)
            Rectangle {
                background: back_touch.pressed ? accent.darker(0.3) : panel_bg;
                border-radius: 14px;
                width: 183px;
                border-width: 2px;
                border-color: back_touch.pressed ? #ffffff : accent;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            height: 30px;
                            text: root.i18n.tuner_btn;
                            color: back_touch.pressed ? #000000 : accent;
                            font-size: 22px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            height: 20px;
                            text: root.i18n.live_view;
                            color: back_touch.pressed ? #222230 : dim_text;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                back_touch := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.switch_to_slave();
                        }
                    }
                }
            }
        }

        // ROW 2: Range Settings (Base Octave & Octave Range & MIDI settings)
        HorizontalLayout {
            spacing: 12px;
            height: 136px;
            
            // Base Octave
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 183px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.base_octave; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        TouchArea {
                            width: 56px; height: 56px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 28px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "-"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.current_octave > -1) { 
                                    root.current_octave -= 1;
                                    root.octave_changed(root.current_octave); 
                                } 
                            }
                        }
                        Text { text: root.current_octave; font-size: 36px; font-weight: 800; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 34px; }
                        TouchArea {
                            width: 56px; height: 56px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 28px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "+"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.current_octave < 9) { 
                                    root.current_octave += 1;
                                    root.octave_changed(root.current_octave); 
                                } 
                            }
                        }
                    }
                }
            }

            // Octave Range
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 183px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.octave_range; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        TouchArea {
                            width: 56px; height: 56px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 28px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "-"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.octave_range > 1) { 
                                    root.octave_range -= 1;
                                    root.range_changed(root.octave_range); 
                                } 
                            }
                        }
                        Text { text: root.octave_range; font-size: 36px; font-weight: 800; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 34px; }
                        TouchArea {
                            width: 56px; height: 56px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 28px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "+"; color: text_color; font-size: 34px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.octave_range < 7) { 
                                    root.octave_range += 1;
                                    root.range_changed(root.octave_range); 
                                } 
                            }
                        }
                    }
                }
            }
            
            // MIDI Mode
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 183px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.midi_mode; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        for mode in ["Standard", "MPE"]: TouchArea {
                            height: 48px;
                            Rectangle {
                                border-radius: 10px;
                                background: root.midi_mode == mode ? accent : (parent.pressed ? #444458 : #333340);
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; alignment: center;
                                    Text { text: mode; color: root.midi_mode == mode ? #000000 : text_color; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            clicked => { 
                                root.midi_mode = mode;
                                if (mode == "Standard") {
                                    root.pb_range = 2;
                                    root.pb_range_changed(2);
                                } else {
                                    root.pb_range = 48;
                                    root.pb_range_changed(48);
                                }
                                root.midi_mode_changed(mode); 
                            }
                        }
                    }
                }
            }

            // Pitch Bend Range
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 183px;
                VerticalLayout {
                    padding: 8px; padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.pb_range; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px; alignment: center;
                        for val in [2, 12, 24, 48]: TouchArea {
                            height: 48px;
                            Rectangle {
                                border-radius: 10px;
                                background: root.pb_range == val ? accent : (parent.pressed ? #444458 : #333340);
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; alignment: center;
                                    Text { text: val; color: root.pb_range == val ? #000000 : text_color; font-size: 19px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            clicked => { 
                                root.pb_range = val;
                                root.pb_range_changed(val); 
                            }
                        }
                    }
                }
            }
        }

        // ROW 3: Theremin Specific (Quantization & Filter & Info)
        HorizontalLayout {
            spacing: 12px;
            height: 136px;

            // Pitch Quantization (Correction) - Compacted to 364px
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 364px;
                VerticalLayout {
                    padding: 8px; padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
                    Text { text: root.i18n.pitch_correction; color: dim_text; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 5px; alignment: center;
                        for val in [0, 25, 50, 75, 100]: TouchArea {
                            height: 48px;
                            Rectangle {
                                border-radius: 10px;
                                background: root.pitch_quantization == val ? accent : (parent.pressed ? #444458 : #333340);
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; alignment: center;
                                    Text { text: val + "%"; color: root.pitch_quantization == val ? #000000 : text_color; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            clicked => { 
                                root.pitch_quantization = val;
                                root.quantization_changed(val); 
                            }
                        }
                    }
                }
            }

            // Filter Speed (232px)
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 232px;
                VerticalLayout {
                    padding: 8px; padding-left: 8px; padding-right: 8px; spacing: 6px; alignment: center;
                    Text {
                        height: 28px;
                        text: root.i18n.response_filter;
                        color: dim_text;
                        font-size: 18px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 6px; alignment: center;
                        for item in [
                            { id: "Slow", label: root.i18n.filter_slow },
                            { id: "Med", label: root.i18n.filter_med },
                            { id: "Fast", label: root.i18n.filter_fast }
                        ]: TouchArea {
                            height: 48px;
                            Rectangle {
                                border-radius: 10px;
                                background: root.filter_speed == item.id ? accent : (parent.pressed ? #444458 : #333340);
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; alignment: center;
                                    Text {
                                        text: item.label;
                                        color: root.filter_speed == item.id ? #000000 : text_color;
                                        font-size: 17px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            clicked => { 
                                root.filter_speed = item.id;
                                root.filter_changed(item.id); 
                            }
                        }
                    }
                }
            }

            // Language Switcher in Bottom-Right (52px)
            Rectangle {
                background: lang_touch.pressed ? #333348 : panel_bg;
                border-radius: 14px;
                width: 52px;
                border-width: 2px;
                border-color: #444458;

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: "FR";
                        color: root.i18n.is_french ? accent : dim_text;
                        font-size: 20px;
                        font-weight: root.i18n.is_french ? 900 : 600;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 2px;
                        width: 28px;
                        background: #444458;
                        x: (parent.width - self.width) / 2;
                    }
                    Text {
                        text: "EN";
                        color: !root.i18n.is_french ? accent : dim_text;
                        font-size: 20px;
                        font-weight: !root.i18n.is_french ? 900 : 600;
                        horizontal-alignment: center;
                    }
                }

                lang_touch := TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.language_toggled();
                        }
                    }
                }
            }

            // Version Badge in Bottom-Right (84px)
            Rectangle {
                background: panel_bg;
                border-radius: 14px;
                width: 84px;
                border-width: 2px;
                border-color: #333348;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "VERSION";
                        color: dim_text;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.app_version;
                        color: accent;
                        font-size: 17px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Force Slint software renderer embed_glyphs pass to pre-render French accented glyphs directly in MasterView
        Rectangle {
            visible: false;
            height: 0px;
            Text { text: "RÉPONSE RÉPONSES FILTRE DE RÉPONSE réponse réponses"; font-size: 18px; font-weight: 800; }
            Text { text: "RÉPONSE RÉPONSES FILTRE DE RÉPONSE réponse réponses"; font-size: 17px; font-weight: 700; }
            Text { text: "RÉPONSE RÉPONSES FILTRE DE RÉPONSE réponse réponses"; font-size: 18px; font-weight: 700; }
            Text { text: "◀ ACCORD. ◀ TUNER"; font-size: 22px; font-weight: 900; }
            Text { text: "VUE LIVE LIVE VIEW"; font-size: 14px; font-weight: 700; }
        }
    }
}

export component MasterWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f;
    title: "Theremin Config (Master)";

    in-out property <string> current_root <=> view.current_root;
    in-out property <string> current_scale <=> view.current_scale;
    in-out property <int> current_octave <=> view.current_octave;
    in-out property <int> octave_range <=> view.octave_range;
    in-out property <int> pitch_quantization <=> view.pitch_quantization;
    in-out property <string> filter_speed <=> view.filter_speed;
    in-out property <string> midi_mode <=> view.midi_mode;
    in-out property <int> pb_range <=> view.pb_range;
    in-out property <string> app_version <=> view.app_version;
    in property <UiI18n> i18n <=> view.i18n;
    callback language_toggled <=> view.language_toggled;

    callback root_changed <=> view.root_changed;
    callback scale_changed <=> view.scale_changed;
    callback octave_changed <=> view.octave_changed;
    callback range_changed <=> view.range_changed;
    callback quantization_changed <=> view.quantization_changed;
    callback filter_changed <=> view.filter_changed;
    callback midi_mode_changed <=> view.midi_mode_changed;
    callback pb_range_changed <=> view.pb_range_changed;
    callback switch_to_slave <=> view.switch_to_slave;

    view := MasterView {
        width: 100%;
        height: 100%;
    }
}
