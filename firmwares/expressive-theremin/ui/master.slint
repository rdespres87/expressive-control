export component MasterWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f;
    title: "Theremin Config (Master)";

    in-out property <string> current_root: "C";
    in-out property <string> current_scale: "Chromatic";
    in-out property <int> current_octave: 4;
    in-out property <int> octave_range: 2;
    in-out property <int> pitch_quantization: 50; // 0, 25, 50, 75, 100
    in-out property <string> filter_speed: "Fast";
    in-out property <string> midi_mode: "Standard";
    in-out property <int> pb_range: 2; // 2, 12, 24, 48

    // Callbacks to simulate touching the UI
    callback root_changed(string);
    callback scale_changed(string);
    callback octave_changed(int);
    callback range_changed(int);
    callback quantization_changed(int);
    callback filter_changed(string);
    callback midi_mode_changed(string);
    callback pb_range_changed(int);

    // Theme
    property <color> accent: #00f0ff;
    property <color> text_color: #ffffff;
    property <color> dim_text: #666670;
    property <color> panel_bg: #1a1a24;
    
    // Helper function for roots
    property <[string]> roots: ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    property <int> root_idx: 0;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        // ROW 1: Tonal Settings (Root & Scale)
        HorizontalLayout {
            spacing: 15px;
            height: 130px;
            
            // Root Note
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 40%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "ROOT NOTE"; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 20px;
                        TouchArea {
                            width: 50px; height: 50px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 25px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "<"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.root_idx = root.root_idx > 0 ? root.root_idx - 1 : 11;
                                root.root_changed(root.roots[root.root_idx]); 
                            }
                        }
                        Text { text: root.roots[root.root_idx]; font-size: 40px; font-weight: 800; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 60px; }
                        TouchArea {
                            width: 50px; height: 50px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 25px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: ">"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.root_idx = root.root_idx < 11 ? root.root_idx + 1 : 0;
                                root.root_changed(root.roots[root.root_idx]); 
                            }
                        }
                    }
                }
            }

            // Scale
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 60%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "SCALE"; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 10px; alignment: center;
                        for scale in ["Chromatic", "Major", "Minor", "Penta"]: TouchArea {
                            Rectangle {
                                border-radius: 8px;
                                background: root.current_scale == scale ? accent : #333340;
                                Text { text: scale; color: root.current_scale == scale ? #000000 : text_color; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.current_scale = scale;
                                root.scale_changed(scale); 
                            }
                        }
                    }
                }
            }
        }

        // ROW 2: Range Settings (Base Octave & Octave Range & MIDI settings)
        HorizontalLayout {
            spacing: 15px;
            height: 130px;
            
            // Base Octave
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 25%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "BASE OCTAVE"; color: dim_text; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 10px;
                        TouchArea {
                            width: 40px; height: 40px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 20px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "-"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.current_octave > -1) { 
                                    root.current_octave -= 1;
                                    root.octave_changed(root.current_octave); 
                                } 
                            }
                        }
                        Text { text: root.current_octave; font-size: 30px; font-weight: 800; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 30px; }
                        TouchArea {
                            width: 40px; height: 40px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 20px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "+"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.current_octave < 9) { 
                                    root.current_octave += 1;
                                    root.octave_changed(root.current_octave); 
                                } 
                            }
                        }
                    }
                }
            }

            // Octave Range
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 25%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "OCTAVE RANGE"; color: dim_text; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 10px;
                        TouchArea {
                            width: 40px; height: 40px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 20px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "-"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.octave_range > 1) { 
                                    root.octave_range -= 1;
                                    root.range_changed(root.octave_range); 
                                } 
                            }
                        }
                        Text { text: root.octave_range; font-size: 30px; font-weight: 800; color: text_color; horizontal-alignment: center; vertical-alignment: center; width: 30px; }
                        TouchArea {
                            width: 40px; height: 40px;
                            Rectangle {
                                width: 100%; height: 100%; border-radius: 20px; background: parent.pressed ? accent.darker(0.5) : #333340;
                                Text { text: "+"; color: text_color; font-size: 30px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                if (root.octave_range < 7) { 
                                    root.octave_range += 1;
                                    root.range_changed(root.octave_range); 
                                } 
                            }
                        }
                    }
                }
            }
            
            // MIDI Mode
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 25%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "MIDI MODE"; color: dim_text; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 10px; alignment: center;
                        for mode in ["Standard", "MPE"]: TouchArea {
                            Rectangle {
                                border-radius: 8px;
                                background: root.midi_mode == mode ? accent : #333340;
                                Text { text: mode; color: root.midi_mode == mode ? #000000 : text_color; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.midi_mode = mode;
                                // Automatically adjust PB range to logical defaults
                                if (mode == "Standard") {
                                    root.pb_range = 2;
                                    root.pb_range_changed(2);
                                } else {
                                    root.pb_range = 48;
                                    root.pb_range_changed(48);
                                }
                                root.midi_mode_changed(mode); 
                            }
                        }
                    }
                }
            }

            // Pitch Bend Range
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 25%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "PB RANGE"; color: dim_text; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 5px; alignment: center;
                        for val in [2, 12, 24, 48]: TouchArea {
                            Rectangle {
                                border-radius: 8px;
                                background: root.pb_range == val ? accent : #333340;
                                Text { text: val; color: root.pb_range == val ? #000000 : text_color; font-size: 16px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.pb_range = val;
                                root.pb_range_changed(val); 
                            }
                        }
                    }
                }
            }
        }

        // ROW 3: Theremin Specific (Quantization & Filter)
        HorizontalLayout {
            spacing: 15px;
            height: 130px;

            // Pitch Quantization (Correction)
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 60%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "PITCH CORRECTION (QUANTIZATION)"; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 10px; alignment: center;
                        for val in [0, 25, 50, 75, 100]: TouchArea {
                            Rectangle {
                                border-radius: 8px;
                                background: root.pitch_quantization == val ? accent : #333340;
                                Text { text: val + "%"; color: root.pitch_quantization == val ? #000000 : text_color; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.pitch_quantization = val;
                                root.quantization_changed(val); 
                            }
                        }
                    }
                }
            }

            // Filter Speed
            Rectangle {
                background: panel_bg;
                border-radius: 12px;
                width: 40%;
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: center;
                    Text { text: "RESPONSE FILTER"; color: dim_text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    HorizontalLayout {
                        spacing: 10px; alignment: center;
                        for speed in ["Slow", "Med", "Fast"]: TouchArea {
                            Rectangle {
                                border-radius: 8px;
                                background: root.filter_speed == speed ? accent : #333340;
                                Text { text: speed; color: root.filter_speed == speed ? #000000 : text_color; font-size: 20px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            clicked => { 
                                root.filter_speed = speed;
                                root.filter_changed(speed); 
                            }
                        }
                    }
                }
            }
        }
    }
}
