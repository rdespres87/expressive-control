export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f; // Very dark warm background to contrast with wood
    title: "Theremin Tuner (Slave)";

    // Data injected by the Rust firmware via UART
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    
    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ff00; // Green for perfect pitch
    property <color> warning_color: #ffaa00; // Orange for slightly off
    property <color> danger_color: #ff2a5f; // Red for very off

    // Dynamic color logic: Green if within 5 cents, Orange if <= 15, Red beyond
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) <= 5.0 ? perfect_color : (abs(root.cents) <= 15.0 ? warning_color : danger_color));

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        
        // TOP: Half-Moon Tuner Gauge
        gauge := Rectangle {
            height: 220px;
            width: 100%;
            
            property <float> r: 160.0;
            property <float> cx: self.width / 1px / 2.0;
            property <float> cy: 210.0;
            property <angle> current_angle: root.cents * 1.8deg;
            
            // Background track (full half moon)
            Path {
                stroke: #1a1a24;
                stroke-width: 24px;
                // Start from left (-90deg)
                MoveTo { x: gauge.cx - gauge.r; y: gauge.cy; }
                // Arc to right (+90deg)
                ArcTo {
                    radius-x: gauge.r;
                    radius-y: gauge.r;
                    x: gauge.cx + gauge.r;
                    y: gauge.cy;
                    sweep: true; // clockwise
                }
            }
            
            // Filled dynamic arc (starts at center, arcs left or right)
            Path {
                stroke: root.is_active ? root.tune_color : transparent;
                stroke-width: 24px;
                
                // Start from center (top)
                MoveTo { x: gauge.cx; y: gauge.cy - gauge.r; }
                
                // End at current_angle
                ArcTo {
                    radius-x: gauge.r;
                    radius-y: gauge.r;
                    x: gauge.cx + gauge.r * sin(gauge.current_angle);
                    y: gauge.cy - gauge.r * cos(gauge.current_angle);
                    sweep: root.cents > 0.0;
                }
            }
            
            // Add a discrete center tick marker
            Path {
                stroke: root.is_active && abs(root.cents) < 2.5 ? root.perfect_color : #ffffff;
                stroke-width: 4px;
                MoveTo { x: gauge.cx; y: gauge.cy - gauge.r - 20.0; }
                LineTo { x: gauge.cx; y: gauge.cy - gauge.r + 20.0; }
            }
        }
        
        // MIDDLE: Note Display
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            
            Text {
                text: root.is_active ? root.note_name : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                animate color { duration: 200ms; }
            }
            
            Text {
                text: root.is_active ? root.octave : "";
                font-size: 60px;
                font-weight: 700;
                color: root.is_active ? root.accent_color : transparent;
                vertical-alignment: bottom;
            }
        }
        
        // BOTTOM: Exact Cents Text removed
    }
}
