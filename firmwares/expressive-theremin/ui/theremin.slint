export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f; // Very dark warm background to contrast with wood
    title: "Theremin Tuner (Slave)";

    // Data injected by the Rust firmware via UART
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    
    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ff88; // Green for perfect pitch
    property <color> warning_color: #ffaa00; // Orange for slightly off
    property <color> danger_color: #ff3344; // Red for very off

    // Dynamic color logic: Green if within 5 cents, Orange if <= 15, Red beyond
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) <= 5.0 ? perfect_color : (abs(root.cents) <= 15.0 ? warning_color : danger_color));

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        
        // TOP: Strobe / LED segment gauge
        gauge := Rectangle {
            height: 270px; // Occupe plus de la moitié de l'écran (480px)
            width: 100%;
            
            property <float> cx: self.width / 1px / 2.0;
            property <float> cy: 260.0; // Centre de rotation abaissé
            
            // 101 radial LED segments (1 tick = 1 cent de résolution !)
            for i in 101: Rectangle {
                property <angle> a: -90deg + i * 1.8deg; // From -90 (left) to +90 (right), 180deg / 100 = 1.8deg
                property <float> tick_cents: -50.0 + i * 1.0; // From -50 to +50, 100 cents / 100 = 1.0 cent
                
                // Radius of the outer edge of the LED (Agrandissement massif)
                property <float> outer_r: 240.0;
                
                // Container height is exactly twice the radius so it rotates perfectly around cy
                width: (i == 50) ? 6px : 3px; // Ticks plus fins car il y en a 101
                height: outer_r * 2.0 * 1px;
                x: gauge.cx * 1px - self.width / 2;
                y: gauge.cy * 1px - self.height / 2;
                
                transform-rotation: a;
                
                // Lit if it's between center and current cents
                property <bool> is_lit: root.is_active && (
                    (root.cents <= -0.5 && tick_cents >= root.cents && tick_cents <= 0.0) ||
                    (root.cents >= 0.5 && tick_cents <= root.cents && tick_cents >= 0.0) ||
                    (abs(root.cents) < 0.5 && i == 50)
                );

                // The actual visible LED
                Rectangle {
                    width: 100%;
                    height: (i == 50) ? 55px : 30px; // Ticks plus longs
                    y: 0px; // Placed at the very top of the container
                    background: parent.is_lit ? root.tune_color : #1a1a24;
                    border-radius: self.width / 2;
                    animate background { duration: 80ms; }
                }
            }
        }
        
        // MIDDLE: Note Display
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            
            Text {
                text: root.is_active ? root.note_name : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                animate color { duration: 200ms; }
            }
            
            Text {
                text: root.is_active ? root.octave : "";
                font-size: 60px;
                font-weight: 700;
                color: root.is_active ? root.accent_color : transparent;
                vertical-alignment: bottom;
            }
        }
    }
}

