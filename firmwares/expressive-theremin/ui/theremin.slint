import { UiI18n } from "i18n_types.slint";

export component SlaveView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0c0b0f;

    // Data injected by the Rust firmware
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    in property <float> volume: 0.0; // 0.0 to 1.0
    in property <float> expression: 0.0; // 0.0 to 1.0
    in property <string> frequency: "-- Hz";
    in property <string> transpose: "+0";
    in property <float> ref_freq_hz: 440.0;
    in property <bool> is_muted: false;
    in property <UiI18n> i18n;

    callback switch_to_master();

    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ff88; // Green for perfect pitch
    property <color> warning_color: #ffaa00; // Orange for slightly off
    property <color> danger_color: #ff3344; // Red for very off

    // Dynamic color logic: Green if within 10 cents, Orange if <= 20, Red beyond
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) <= 10.0 ? perfect_color : (abs(root.cents) <= 20.0 ? warning_color : danger_color));

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 20px;
        
        // LEFT: Volume Bargraph (CC7)
        VerticalLayout {
            width: 44px;
            alignment: center;
            spacing: 12px; 
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 26px; 
                    height: 300px; 
                    background: #1a1a24;
                    border-radius: 13px;
                    HorizontalLayout { alignment: center; 
                        Rectangle {
                            width: 100%;
                            height: parent.height * root.volume;
                            y: parent.height - self.height;
                            background: root.accent_color;
                            border-radius: 13px;
                            animate height { duration: 50ms; }
                        }
                    }
                }
            }
            Text { text: "VOL"; color: #88889a; font-size: 16px; horizontal-alignment: center; font-weight: 800; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            width: 640px;
            
            // TOP: Strobe / LED segment gauge placeholder (vector-rendered directly to framebuffer)
            gauge := Rectangle {
                height: 250px; 
                width: 100%;
            }
            
            // MIDDLE: Note Display (A4)
            Text {
                text: root.is_active ? root.note_name + root.octave : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                horizontal-alignment: center;
                animate color { duration: 200ms; }
            }
            
            // BOTTOM: Details
            HorizontalLayout {
                alignment: center;
                spacing: 36px;
                Text { text: root.is_active ? root.frequency : "-- Hz"; font-size: 24px; color: #9999aa; font-weight: 700; vertical-alignment: center; }
                Text { text: "REF " + root.ref_freq_hz + "Hz"; font-size: 22px; color: #ffd700; font-weight: 800; vertical-alignment: center; }
                Text { text: root.i18n.transpose + root.transpose; font-size: 24px; color: #9999aa; font-weight: 700; vertical-alignment: center; }
            }
        }

        // RIGHT: Expression Bargraph (CC11)
        VerticalLayout {
            width: 44px;
            alignment: center;
            spacing: 12px; 
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 26px; 
                    height: 300px; 
                    background: #1a1a24;
                    border-radius: 13px;
                    HorizontalLayout { alignment: center;
                        Rectangle {
                            width: 100%;
                            height: parent.height * root.expression;
                            y: parent.height - self.height; 
                            background: #ff0077; 
                            border-radius: 13px;
                            animate height { duration: 50ms; }
                        }
                    }
                }
            }
            Text { text: "EXP"; color: #88889a; font-size: 16px; horizontal-alignment: center; font-weight: 800; }
        }
    }

    // Top-Right: Switch to Config / Master Screen Button (Shifted right, single clean label)
    config_btn := Rectangle {
        x: root.width - self.width - 16px;
        y: 14px;
        width: 154px;
        height: 48px;
        border-radius: 12px;
        background: config_touch.pressed ? #00f0ff : (config_touch.has_hover ? #2a2a3e : #1c1c28);
        border-width: 2px;
        border-color: config_touch.pressed ? #ffffff : #00f0ff;
        
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Text {
                    height: 28px;
                    text: root.i18n.settings_btn;
                    font-size: 19px;
                    font-weight: 800;
                    color: config_touch.pressed ? #000000 : #00f0ff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        
        config_touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.switch_to_master();
                }
            }
        }
    }

    // Top-Center: MUTE Indicator Badge (Visible when hardware mute button is toggled)
    if root.is_muted : Rectangle {
        x: (root.width - self.width) / 2;
        y: 14px;
        width: 140px;
        height: 44px;
        border-radius: 12px;
        background: #ff2244;
        border-width: 2px;
        border-color: #ffffff;

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "MUTED";
                    font-size: 20px;
                    font-weight: 900;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Force Slint software renderer embed_glyphs pass to pre-render French accented glyphs directly in SlaveView
    Rectangle {
        visible: false;
        width: 0px; height: 0px; x: -1000px; y: -1000px;
        Text { text: "RÉGLAGES réglages Réglages Settings"; font-size: 19px; font-weight: 800; }
        Text { text: "RÉGLAGES réglages Réglages Settings"; font-size: 18px; font-weight: 800; }
    }
}

export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f;
    title: "Theremin Tuner (Slave)";

    in property <string> note_name <=> view.note_name;
    in property <string> octave <=> view.octave;
    in property <float> cents <=> view.cents;
    in property <bool> is_active <=> view.is_active;
    in property <float> volume <=> view.volume;
    in property <float> expression <=> view.expression;
    in property <string> frequency <=> view.frequency;
    in property <string> transpose <=> view.transpose;
    in property <float> ref_freq_hz <=> view.ref_freq_hz;
    in property <bool> is_muted <=> view.is_muted;
    in property <UiI18n> i18n <=> view.i18n;

    callback switch_to_master <=> view.switch_to_master;

    view := SlaveView {
        width: 100%;
        height: 100%;
    }
}
