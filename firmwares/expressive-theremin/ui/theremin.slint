export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f; // Very dark warm background to contrast with wood
    title: "Theremin Tuner (Slave)";

    // Data injected by the Rust firmware via UART
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    
    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ff00; // Green for perfect pitch
    property <color> warning_color: #ffaa00; // Orange for slightly off
    property <color> danger_color: #ff2a5f; // Red for very off

    // Dynamic color logic: Green if within 5 cents, Orange if <= 15, Red beyond
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) <= 5.0 ? perfect_color : (abs(root.cents) <= 15.0 ? warning_color : danger_color));

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        
        // TOP: Half-Moon Tuner Gauge
        Rectangle {
            height: 220px;
            width: 100%;
            
            // 41 segments in the half moon (-90 to +90 degrees)
            // i=0 is furthest left (-50 cents), i=20 is center (0 cents), i=40 is furthest right (+50 cents)
            // Total range is 100 cents. Each tick is 100 / 40 = 2.5 cents.
            for i in 41: Path {
                property <angle> a: -90deg + i * 4.5deg;
                property <float> tick_cents: -50.0 + i * 2.5;
                
                property <float> inner_r: 150.0;
                property <float> outer_r: (i == 20) ? 190.0 : 180.0;
                property <float> cx: parent.width / 1px / 2.0;
                property <float> cy: 210.0;
                
                // Active logic:
                property <bool> is_lit: root.is_active && (
                    (root.cents <= -2.5 && tick_cents >= root.cents && tick_cents <= -2.5) ||
                    (root.cents >= 2.5 && tick_cents <= root.cents && tick_cents >= 2.5) ||
                    (abs(root.cents) < 2.5 && i == 20)
                );

                stroke: is_lit ? root.tune_color : #1a1a24;
                stroke-width: (i == 20) ? 10px : 6px;
                
                MoveTo {
                    x: cx + inner_r * sin(a);
                    y: cy - inner_r * cos(a);
                }
                LineTo {
                    x: cx + outer_r * sin(a);
                    y: cy - outer_r * cos(a);
                }

                animate stroke { duration: 80ms; }
            }
        }
        
        // MIDDLE: Note Display
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            
            Text {
                text: root.is_active ? root.note_name : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                animate color { duration: 200ms; }
            }
            
            Text {
                text: root.is_active ? root.octave : "";
                font-size: 60px;
                font-weight: 700;
                color: root.is_active ? root.accent_color : transparent;
                vertical-alignment: bottom;
            }
        }
        
        // BOTTOM: Exact Cents Text removed
    }
}
