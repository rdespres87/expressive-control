export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f; // Very dark warm background to contrast with wood
    title: "Theremin Tuner (Slave)";

    // Data injected by the Rust firmware via UART
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    
    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ffa6; // Mint green for perfect pitch
    property <color> flat_color: #ffaa00; // Orange/Yellow for flat
    property <color> sharp_color: #ff2a5f; // Pink/Red for sharp

    // Dynamic color logic: Green if within 3 cents, otherwise gradient-like logic
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) < 3.0 ? perfect_color : (root.cents < 0 ? flat_color : sharp_color));

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        
        // TOP: Segmented Bargraph Gauge
        Rectangle {
            height: 140px;
            width: 100%;
            
            // 20 segments on the flat (left) side
            for i in 20: Rectangle {
                // i goes from 0 to 19. i=0 is furthest left, i=19 is closest to center.
                x: 30px + i * ((parent.width / 2 - 50px) / 20);
                y: 50px;
                width: ((parent.width / 2 - 50px) / 20) - 4px;
                height: 40px;
                border-radius: 6px;
                
                // Active if cents is negative and absolute cents maps to this segment or further left
                background: (root.is_active && root.cents < 0.0 && root.cents <= ((i - 20) * 2.5)) ? root.flat_color : #1a1a24;
                drop-shadow-color: (root.is_active && root.cents < 0.0 && root.cents <= ((i - 20) * 2.5)) ? root.flat_color.with-alpha(0.5) : transparent;
                drop-shadow-blur: 8px;
                animate background { duration: 80ms; }
                animate drop-shadow-color { duration: 80ms; }
            }

            // Center Perfect Marker
            Rectangle {
                x: parent.width / 2 - 8px;
                y: 40px;
                width: 16px;
                height: 60px;
                border-radius: 8px;
                background: (root.is_active && abs(root.cents) <= 2.5) ? root.perfect_color : #333340;
                drop-shadow-color: (root.is_active && abs(root.cents) <= 2.5) ? root.perfect_color.with-alpha(0.8) : transparent;
                drop-shadow-blur: 15px;
                animate background { duration: 150ms; }
            }

            // 20 segments on the sharp (right) side
            for i in 20: Rectangle {
                // i goes from 0 to 19. i=0 is closest to center, i=19 is furthest right.
                x: parent.width / 2 + 20px + i * ((parent.width / 2 - 50px) / 20);
                y: 50px;
                width: ((parent.width / 2 - 50px) / 20) - 4px;
                height: 40px;
                border-radius: 6px;
                
                // Active if cents > 0 and cents >= (i+1) * 2.5
                background: (root.is_active && root.cents > 0.0 && root.cents >= ((i + 1) * 2.5)) ? root.sharp_color : #1a1a24;
                drop-shadow-color: (root.is_active && root.cents > 0.0 && root.cents >= ((i + 1) * 2.5)) ? root.sharp_color.with-alpha(0.5) : transparent;
                drop-shadow-blur: 8px;
                animate background { duration: 80ms; }
                animate drop-shadow-color { duration: 80ms; }
            }
        }
        
        // MIDDLE: Note Display
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            
            Text {
                text: root.is_active ? root.note_name : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                animate color { duration: 200ms; }
            }
            
            Text {
                text: root.is_active ? root.octave : "";
                font-size: 60px;
                font-weight: 700;
                color: root.is_active ? root.accent_color : transparent;
                vertical-alignment: bottom;
            }
        }
        
        // BOTTOM: Exact Cents Text
        Text {
            text: root.is_active ? round(root.cents) + " cents" : "STANDBY";
            font-size: 20px;
            font-weight: 600;
            color: root.tune_color;
            horizontal-alignment: center;
            letter-spacing: 2px;
        }
    }
}
