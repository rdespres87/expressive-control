export component SlaveWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0c0b0f; // Very dark warm background to contrast with wood
    title: "Theremin Tuner (Slave)";

    // Data injected by the Rust firmware via UART
    in property <string> note_name: "C";
    in property <string> octave: "4";
    in property <float> cents: 0.0; // -50.0 to +50.0
    in property <bool> is_active: false;
    // New Data
    in property <float> volume: 0.0; // 0.0 to 1.0
    in property <float> expression: 0.0; // 0.0 to 1.0
    in property <string> frequency: "-- Hz";
    in property <string> transpose: "+0";

    // UI Theme
    property <color> accent_color: #00f0ff; // Neon cyan
    property <color> perfect_color: #00ff88; // Green for perfect pitch
    property <color> warning_color: #ffaa00; // Orange for slightly off
    property <color> danger_color: #ff3344; // Red for very off

    // Dynamic color logic: Green if within 10 cents, Orange if <= 20, Red beyond
    property <color> tune_color: !root.is_active ? #333340 : (abs(root.cents) <= 10.0 ? perfect_color : (abs(root.cents) <= 20.0 ? warning_color : danger_color));

    HorizontalLayout {
        padding: 20px;
        spacing: 20px;
        
        // LEFT: Volume Bargraph (CC7)
        VerticalLayout {
            width: 40px;
            alignment: center;
            spacing: 15px; 
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 20px; 
                    height: 300px; 
                    background: #1a1a24;
                    border-radius: 10px;
                    HorizontalLayout { alignment: center; 
                        Rectangle {
                            width: 100%;
                            height: parent.height * root.volume;
                            y: parent.height - self.height;
                            background: root.accent_color;
                            border-radius: 10px;
                            animate height { duration: 50ms; }
                        }
                    }
                }
            }
            Text { text: "VOL"; color: #666670; font-size: 14px; horizontal-alignment: center; font-weight: 700; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            width: 600px;
            
            // TOP: Strobe / LED segment gauge placeholder (vector-rendered directly to framebuffer)
            gauge := Rectangle {
                height: 250px; 
                width: 100%;
                background: #0c0b0f;
            }
            
            // MIDDLE: Note Display (A4)
            Text {
                text: root.is_active ? root.note_name + root.octave : "--";
                font-size: 140px;
                font-weight: 900;
                color: root.is_active ? #ffffff : #333340;
                letter-spacing: -2px;
                horizontal-alignment: center;
                animate color { duration: 200ms; }
            }
            
            // BOTTOM: Details (Freq / Transpose)
            HorizontalLayout {
                alignment: center;
                spacing: 40px;
                Text { text: root.is_active ? root.frequency : "-- Hz"; font-size: 24px; color: #888899; font-weight: 600; }
                Text { text: "TRANSPOSE: " + root.transpose; font-size: 24px; color: #888899; font-weight: 600; }
            }
        }

        // RIGHT: Expression Bargraph (CC11)
        VerticalLayout {
            width: 40px;
            alignment: center;
            spacing: 15px; 
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 20px; 
                    height: 300px; 
                    background: #1a1a24;
                    border-radius: 10px;
                    HorizontalLayout { alignment: center;
                        Rectangle {
                            width: 100%;
                            height: parent.height * root.expression;
                            y: parent.height - self.height; 
                            background: #ff0077; 
                            border-radius: 10px;
                            animate height { duration: 50ms; }
                        }
                    }
                }
            }
            Text { text: "EXP"; color: #666670; font-size: 14px; horizontal-alignment: center; font-weight: 700; }
        }
    }
}

