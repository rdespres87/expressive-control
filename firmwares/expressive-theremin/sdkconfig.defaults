# Enable TinyUSB for Native USB-MIDI Support
CONFIG_USB_OTG_SUPPORTED=y
CONFIG_TINYUSB=y
CONFIG_TINYUSB_MIDI_ENABLED=y
CONFIG_TINYUSB_MIDI_RX_BUFSIZE=64
CONFIG_TINYUSB_MIDI_TX_BUFSIZE=64
CONFIG_ESP_TINYUSB=y
CONFIG_ESP_TINYUSB_MIDI_ENABLED=y

# Force ESP32-S3 native USB to be configured as TinyUSB device (not just serial JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
